# Caddy in front of earth on earth.hillview.cz (compose.yml). It runs on the host network: it sees each
# client's real address and reaches earth on the published loopback port.
#
# NOT PUBLIC YET: only /<EARTH_PREFIX>/... reaches earth, with the prefix
# stripped, so clients use https://earth.hillview.cz/<EARTH_PREFIX> as their base. Everything else is
# a 404. The API hands out release ids, never URLs, so nothing it says leaks or misses the prefix.
# No access log: it would write the prefix down.
(earth) {
	handle_path /{$EARTH_PREFIX}/* {
		# The terrain mosaics as plain files, for clients that read them themselves with GDAL range
		# requests (/vsicurl/, e.g. a depth renderer): only what earth itself
		# reads, never the LAZ downloads or the S-JTSK intermediates. Read-only, no listings, and not
		# re-compressed (the sheets are DEFLATE tiles, and a range read wants the bytes as stored).
		handle_path /dem/* {
			@served path /cuzk/*.vrt /cuzk/warp/* /glo30.vrt /glo30/* /global/* /geoid/*
			handle @served {
				root * /srv/dem
				file_server
			}
			handle {
				respond 404
			}
		}
		handle {
			encode zstd gzip
			# Caddy SETS X-Forwarded-For to the client it sees (it does not pass on one the client
			# sent), so the service can believe it from here and nowhere else (limits.client_ip)
			reverse_proxy 127.0.0.1:8090
		}
	}
	handle {
		respond 404
	}
}

earth.hillview.cz {
	import earth
}

# The same routes in plain HTTP on the server's loopback only, for a tunnel while 80/443 are closed.
# Nothing outside the server reaches it.
http://127.0.0.1:8081 {
	import earth
}
